{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M1 Validation-only public summary; separate from P3 final metrics",
  "description": "Schema checks structure and ranges. tools/aggregate_m1.py additionally validates source hashes, exact per-seed identities, means and sample standard deviations (ddof=1).",
